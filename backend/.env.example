# Copy this file to `.env` and fill in real values. NEVER commit the real .env.

# Environment: "development" or "production"
ENVIRONMENT=development

# REQUIRED in production. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# How long a login stays valid (minutes). 720 = 12 hours.
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Database. Default is a local SQLite file. For cloud hosting use Postgres, e.g.:
#   DATABASE_URL=postgresql+psycopg://user:password@host:5432/shopdb
DATABASE_URL=sqlite:///./shop.db

# Comma-separated list of allowed frontend origins (no trailing slash).
# In production set this to your real site, e.g. https://shop.example.com
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# OPTIONAL: auto-create the first shopkeeper on first run if no user exists.
# Leave blank and use `python manage.py create-admin` instead (recommended).
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Display
CURRENCY_CODE=INR
CURRENCY_SYMBOL=₹

# Shop details printed on the receipt / bill PDF (leave blank to omit)
SHOP_NAME=
SHOP_ADDRESS=
SHOP_PHONE=
